{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal"
    },
    "preview:dev": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "MOBILE_VERSION_POLICY": "fingerprint",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    },
    "production-munim": {
      "extends": "production",
      "credentialsSource": "local",
      "env": {
        "APP_VARIANT": "production",
        "T3CODE_MOBILE_DISTRO": "munim",
        "MOBILE_VERSION_POLICY": "appVersion",
        "EXPO_PUBLIC_MARKETING_SITE_URL": "https://www.munimtech.com",
        "EXPO_PUBLIC_PRIVACY_POLICY_PATH": "privacy",
        "EXPO_PUBLIC_TERMS_OF_SERVICE_PATH": "terms",
        "EXPO_PUBLIC_SECURITY_POLICY_PATH": "privacy",
        "EXPO_PUBLIC_LEGAL_PATH": "privacy",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "production-munim"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6787819824"
      },
      "android": {
        "track": "internal"
      }
    },
    "production-munim": {
      "ios": {
        "ascAppId": "6803353917",
        "ascApiKeyPath": "./credentials/apple/AuthKey_A5X3Y92UJP.p8",
        "ascApiKeyId": "A5X3Y92UJP",
        "ascApiKeyIssuerId": "6f677a98-7245-4fce-a5ae-be933547b809",
        "appleTeamId": "6T5J6U2UVT"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}

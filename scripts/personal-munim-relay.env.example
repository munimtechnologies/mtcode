# Munim relay deployment configuration — install as ~/.mt/munim-relay.env.
# Used by scripts/personal-deploy-relay.sh, which wraps the Alchemy stack in
# infra/relay/. THIS FILE HOLDS REAL SECRETS: keep it outside the repo, never
# commit it, and never let any of these values into a client build.
#
# Do not fill this in for a T3-like $0 setup. Pairing + the static hosted
# app + T3 Connect on desktop are enough. Deploying this stack enables
# Workers Paid, PlanetScale, and Axiom. scripts/personal-deploy-relay.sh
# refuses unless FORCE_PAID_RELAY=1.
#
# The stack provisions (see infra/relay/alchemy.run.ts + src/worker.ts):
#   - the relay Worker (custom domain, cron trigger, nodejs_compat)
#   - Cloudflare Queues (APNS delivery + dead-letter) — Workers Paid plan
#   - Cloudflare Hyperdrive in front of a PlanetScale Postgres cluster
#   - a retained PlanetScale Postgres database (PS_20, 2 replicas — paid)
#   - Axiom trace datasets + scoped ingest tokens
#   - per-environment cloudflared tunnels + DNS records under the tunnel zone

# --- Provider credentials (consumed by Alchemy at deploy time) ---

# Cloudflare API token with account-level Workers Scripts/Queues/Hyperdrive/
# Tunnel edit + zone-level Zone/DNS/Workers Routes edit on both zones below.
# The wrangler OAuth login is NOT enough (it lacks dns_records scope).
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...

# PlanetScale service token (Organization settings > Service tokens) with
# database create/read/write on the organization.
PLANETSCALE_API_TOKEN_ID=...
PLANETSCALE_API_TOKEN=...
PLANETSCALE_ORGANIZATION=...

# Axiom API token (org-level, able to create datasets and API tokens).
AXIOM_API_KEY=...

# --- Relay stack configuration (infra/relay/.env.example equivalents) ---

# Zone that serves the relay API. Stage `prod` derives relay.<zone> unless
# RELAY_DOMAIN overrides it.
RELAY_API_ZONE_NAME=munimtech.com
# Zone under which managed tunnel endpoints are provisioned. Must be a zone in
# the same Cloudflare account (a registered domain or delegated subdomain
# zone; plain munimtech.com works but managed endpoints then take labels
# directly under it).
RELAY_TUNNEL_ZONE_NAME=munimtech.com
# Explicit relay hostname for the Worker custom domain.
RELAY_DOMAIN=mtcode-relay.munimtech.com

# Munim Clerk application (Clerk Dashboard > API keys). The audience must
# match the `aud` claim on the t3-relay JWT template.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Apple Push Notification service (Apple Developer > Keys > APNs key).
# Required by the stack even if mobile Live Activities are unused.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...

# Alchemy stage. `prod` is deliberate: non-prod stages reference the prod
# stage's PlanetScale database and DNS zones, so the Munim deployment must own
# its own prod stage (state lives in the Munim Cloudflare account, unrelated
# to T3's production).
stage=prod
